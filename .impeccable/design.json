  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one filled action on a screen: brand fill, white label.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><polygon points=\"6 3 20 12 6 21 6 3\"/></svg>Start practice</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:8px 16px;border:none;border-radius:var(--radius-lg,12px);background:var(--color-brand,#a3264c);color:var(--color-on-brand,#fff);font:600 0.875rem/1 var(--font-sans,Inter,sans-serif);box-shadow:var(--shadow-xs);cursor:pointer;transition:background 150ms cubic-bezier(0.4,0,0.2,1),transform 150ms}.ds-btn-primary:hover{background:var(--color-brand-strong,#b92f58)}.ds-btn-primary:active{transform:scale(0.97)}.ds-btn-primary:focus-visible{outline:3px solid var(--color-primary,#f27b9f);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Surface fill with full border; hover tints the border rose.",
      "html": "<button class=\"ds-btn-secondary\">View all papers</button>",
      "css": ".ds-btn-secondary{min-height:44px;padding:8px 16px;border:1px solid var(--color-border,#3a2b32);border-radius:var(--radius-lg,12px);background:var(--color-surface,#1e161a);color:var(--color-text,#f7eff2);font:500 0.875rem/1 var(--font-sans,Inter,sans-serif);cursor:pointer;transition:background 150ms,border-color 150ms}.ds-btn-secondary:hover{border-color:var(--color-primary-300,rgba(242,123,159,.35));background:var(--color-surface-hover,#261c21)}.ds-btn-secondary:focus-visible{outline:3px solid var(--color-primary,#f27b9f);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Quiet tertiary action in secondary text.",
      "html": "<button class=\"ds-btn-ghost\">Skip</button>",
      "css": ".ds-btn-ghost{min-height:44px;padding:8px 16px;border:none;border-radius:var(--radius-lg,12px);background:transparent;color:var(--color-text-secondary,#cdbcc3);font:500 0.875rem/1 var(--font-sans,Inter,sans-serif);cursor:pointer;transition:background 150ms,color 150ms}.ds-btn-ghost:hover{background:var(--color-bg-secondary,#1a1317);color:var(--color-text,#f7eff2)}.ds-btn-ghost:focus-visible{outline:3px solid var(--color-primary,#f27b9f);outline-offset:2px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Surface field, 1.5px border, rose focus halo.",
      "html": "<input class=\"ds-input\" placeholder=\"Type your answer\" />",
      "css": ".ds-input{width:100%;min-height:44px;padding:12px 16px;border:1.5px solid var(--color-border,#3a2b32);border-radius:var(--radius-lg,12px);background:var(--color-surface,#1e161a);color:var(--color-text,#f7eff2);font:400 0.875rem var(--font-sans,Inter,sans-serif);outline:none;transition:border-color 150ms,box-shadow 150ms}.ds-input::placeholder{color:var(--color-text-tertiary,#a28f98)}.ds-input:hover{border-color:var(--color-text-tertiary,#a28f98)}.ds-input:focus{border-color:var(--color-primary,#f27b9f);box-shadow:0 0 0 3px var(--color-primary-100,rgba(242,123,159,.16))}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Nav pills on the burgundy brand field.",
      "html": "<nav class=\"ds-nav\"><span class=\"ds-nav-label\">Study</span><a class=\"ds-nav-item is-active\" href=\"#\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\" rx=\"1\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\" rx=\"1\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\" rx=\"1\"/></svg>Dashboard</a><a class=\"ds-nav-item\" href=\"#\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 7v14\"/><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"/></svg>Notes</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:2px;width:256px;padding:8px 12px;background:var(--sidebar-bg,#2a0d18);border-radius:12px}.ds-nav-label{padding:8px 12px;font:600 0.75rem var(--font-sans,Inter,sans-serif);color:var(--sidebar-label,#b98a9b)}.ds-nav-item{display:flex;align-items:center;gap:12px;min-height:44px;padding:0 12px;border-radius:12px;color:var(--sidebar-text-muted,#d4adbb);font:500 0.9375rem var(--font-sans,Inter,sans-serif);text-decoration:none;transition:background 150ms,color 150ms}.ds-nav-item svg{opacity:.85}.ds-nav-item:hover{background:var(--sidebar-hover,rgba(255,255,255,.06));color:var(--sidebar-text,#f6e7ec)}.ds-nav-item.is-active{background:var(--sidebar-active,rgba(242,123,159,.2));color:var(--sidebar-text,#f6e7ec);font-weight:600}.ds-nav-item.is-active svg{opacity:1}.ds-nav-item:focus-visible{outline:2px solid var(--sidebar-text,#f6e7ec);outline-offset:-2px}"
    },
    {
      "name": "Streak Chip",
      "kind": "chip",
      "refersTo": "streak-chip",
      "description": "Pill showing the streak; lights gold only when a streak is live.",
      "html": "<span class=\"ds-streak is-lit\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z\"/></svg><b>12</b> day streak</span>",
      "css": ".ds-streak{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:0 16px;border-radius:9999px;border:1px solid var(--color-border,#3a2b32);background:var(--color-surface,#1e161a);color:var(--color-text-secondary,#cdbcc3);font:400 0.875rem var(--font-sans,Inter,sans-serif)}.ds-streak b{font-size:1rem;font-weight:700;color:var(--color-text,#f7eff2);font-variant-numeric:tabular-nums}.ds-streak.is-lit{border-color:color-mix(in srgb,var(--color-accent,#f2b544) 40%,transparent);background:color-mix(in srgb,var(--color-accent,#f2b544) 10%,var(--color-surface,#1e161a))}.ds-streak.is-lit svg{color:var(--color-accent,#f2b544)}"
    },
    {
      "name": "Continue Card",
      "kind": "card",
      "refersTo": "continue-card",
      "description": "Signature: the single filled primary action on Home.",
      "html": "<a class=\"ds-continue\" href=\"#\"><div><h3 class=\"ds-continue-title\">Mole concept and Avogadro constant</h3><p class=\"ds-continue-sub\">AL Chemistry · Formulae &amp; Amount</p><div class=\"ds-continue-track\"><div class=\"ds-continue-fill\"></div></div></div><span class=\"ds-continue-action\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><polygon points=\"6 3 20 12 6 21 6 3\"/></svg>Resume</span></a>",
      "css": ".ds-continue{position:relative;isolation:isolate;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;gap:24px;min-height:200px;max-width:640px;padding:24px;border-radius:20px;background:var(--color-brand,#a3264c);color:#fff;text-decoration:none;transition:transform 250ms cubic-bezier(0.4,0,0.2,1),box-shadow 250ms}.ds-continue::before{content:'';position:absolute;inset:0;z-index:-1;background:radial-gradient(120% 90% at 100% 0%,rgba(255,255,255,.16),transparent 55%),radial-gradient(80% 70% at 0% 100%,rgba(0,0,0,.18),transparent 60%)}.ds-continue:hover{transform:translateY(-2px);box-shadow:0 16px 32px -12px rgba(139,30,63,.55)}.ds-continue:focus-visible{outline:3px solid var(--color-primary,#f27b9f);outline-offset:3px}.ds-continue-title{margin:0;font:700 clamp(1.375rem,1.1rem + 1vw,1.875rem)/1.2 var(--font-sans,Inter,sans-serif);letter-spacing:-0.02em;color:#fff}.ds-continue-sub{margin:8px 0 0;font-size:.875rem;color:rgba(255,255,255,.82)}.ds-continue-track{margin-top:16px;max-width:22rem;height:4px;border-radius:9999px;background:rgba(255,255,255,.2);overflow:hidden}.ds-continue-fill{width:40%;height:100%;background:#fff;border-radius:inherit}.ds-continue-action{align-self:flex-start;display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 20px;border-radius:12px;background:#fff;color:#7a1634;font:700 .875rem var(--font-sans,Inter,sans-serif)}"
    },
    {
      "name": "Subject Tile",
      "kind": "card",
      "refersTo": "subject-tile",
      "description": "Subject with mastery ring that fills once on first paint.",
      "html": "<a class=\"ds-tile\" href=\"#\"><span class=\"ds-tile-ring\"><svg viewBox=\"0 0 52 52\"><circle class=\"ds-ring-track\" cx=\"26\" cy=\"26\" r=\"23.5\"/><circle class=\"ds-ring-fill\" cx=\"26\" cy=\"26\" r=\"23.5\" stroke-dasharray=\"147.65\" stroke-dashoffset=\"88.6\"/></svg><span class=\"ds-tile-pct\">40<small>%</small></span></span><span class=\"ds-tile-text\"><b>Chemistry</b><span>83 of 208 notes</span></span><svg class=\"ds-tile-chev\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m9 18 6-6-6-6\"/></svg></a>",
      "css": ".ds-tile{display:flex;align-items:center;gap:16px;width:260px;min-height:88px;padding:16px;border-radius:16px;border:1px solid var(--color-border-light,#2b2026);background:var(--color-surface,#1e161a);color:var(--color-text,#f7eff2);text-decoration:none;transition:border-color 150ms,transform 250ms,box-shadow 250ms}.ds-tile:hover{border-color:var(--color-primary-300,rgba(242,123,159,.35));transform:translateY(-2px);box-shadow:var(--shadow-md)}.ds-tile:focus-visible{outline:3px solid var(--color-primary,#f27b9f);outline-offset:2px}.ds-tile-ring{position:relative;width:52px;height:52px;flex-shrink:0}.ds-tile-ring svg{width:100%;height:100%;transform:rotate(-90deg)}.ds-ring-track{fill:none;stroke:var(--color-bg-tertiary,#261c21);stroke-width:5}.ds-ring-fill{fill:none;stroke:var(--color-primary,#f27b9f);stroke-width:5;stroke-linecap:round}.ds-tile-pct{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:.8125rem;font-weight:700;font-variant-numeric:tabular-nums}.ds-tile-pct small{font-size:.625rem;font-weight:600;color:var(--color-text-secondary,#cdbcc3)}.ds-tile-text{display:flex;flex-direction:column;gap:2px;flex:1;font-family:var(--font-sans,Inter,sans-serif)}.ds-tile-text span{font-size:.8125rem;color:var(--color-text-secondary,#cdbcc3);font-variant-numeric:tabular-nums}.ds-tile-chev{color:var(--color-text-tertiary,#a28f98);transition:transform 150ms,color 150ms}.ds-tile:hover .ds-tile-chev{color:var(--color-primary,#f27b9f);transform:translateX(2px)}"
    },
    {
      "name": "Segmented Tabs",
      "kind": "custom",
      "refersTo": "segmented-tab-active",
      "description": "Recessed track; active tab lifts to surface.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\"><button class=\"ds-tab is-active\" role=\"tab\">A Level</button><button class=\"ds-tab\" role=\"tab\">IGCSE</button><button class=\"ds-tab\" role=\"tab\">English</button></div>",
      "css": ".ds-tabs{display:inline-flex;gap:2px;padding:3px;border-radius:12px;background:var(--color-bg-secondary,#1a1317);border:1px solid var(--color-border-light,#2b2026)}.ds-tab{min-height:36px;padding:0 16px;border:none;border-radius:9px;background:none;color:var(--color-text-secondary,#cdbcc3);font:600 .875rem/1 var(--font-sans,Inter,sans-serif);cursor:pointer;transition:background 150ms,color 150ms}.ds-tab:hover{color:var(--color-text,#f7eff2)}.ds-tab.is-active{background:var(--color-surface,#1e161a);color:var(--color-text,#f7eff2);box-shadow:var(--shadow-xs)}.ds-tab:focus-visible{outline:3px solid var(--color-primary,#f27b9f);outline-offset:2px}"
    },
    {
      "name": "Note Callout",
      "kind": "custom",
      "refersTo": "",
      "description": "Reading-surface callout driven by --block-accent/--block-ink; Patrick Hand title.",
      "html": "<div class=\"ds-callout ds-callout-key\"><div class=\"ds-callout-title\">Key idea</div><div class=\"ds-callout-body\">One mole contains 6.02 × 10²³ particles.</div></div>",
      "css": ".ds-callout{--block-accent:#60a5fa;--block-ink:#93c5fd;max-width:520px;border-radius:12px;padding:16px 20px;background:color-mix(in srgb,var(--block-accent) 10%,transparent);border:1px solid color-mix(in srgb,var(--block-accent) 26%,transparent)}.ds-callout-title{margin-bottom:8px;font:700 1rem 'Patrick Hand',cursive;color:var(--block-ink)}.ds-callout-body{font:400 .875rem/1.75 var(--font-sans,Inter,sans-serif);color:var(--color-text,#f7eff2)}"
    }
  ],
  "narrative": {
    "northStar": "The Evening Desk",
    "overview": "Study Smart is the category-standard study app executed at full craft, made its own by one decision: burgundy owns the brand field. The sidebar is a solid burgundy column, the single primary action on any screen is a burgundy fill, and progress is drawn in the burgundy family; everything else sits on warm neutrals that carry a faint burgundy cast. The reference bar is Notion's calm for content, Duolingo's motivation for streaks, Quizlet's flow for study tools and Khan Academy's mastery progress, without borrowing any of their colours.\n\nDark is the default because students revise at night: a warm near-black ground, surfaces one tonal step lifted, hairline warm borders. Light is first-class, not an inversion: a blush-white ground, white surfaces, the same burgundy as a deeper ink. Every colour token is defined twice, once per theme, and components only ever read tokens, so a component built once works in both.\n\nDensity is calm and generous. Cards are softly rounded, icons are line icons (lucide), numbers are tabular, and motion is a single settle on load plus the progress-ring fill. Note pages switch register: Inter body text set for long reading, with Patrick Hand headings as the one handwritten voice in the product.",
    "keyCharacteristics": [
      "Burgundy brand field: sidebar, the one filled primary action, progress.",
      "Rose is the accent that reads as text and icons on the dark ground; burgundy is for fills.",
      "Gold appears only for streaks and achievement; green only for done.",
      "Warm burgundy-tinted neutrals in both themes, hairline borders, flat at rest.",
      "Inter everywhere in the UI; Patrick Hand only for note headings.",
      "Progress rings for subject mastery; one staggered settle on load; reduced motion respected."
    ],
    "rules": [
      {
        "name": "The Brand Field Rule",
        "body": "Burgundy fills mean \"brand\" or \"the one thing to do next\". It fills the sidebar, the single primary action and progress. Never use it as a decorative tile colour.",
        "section": "colors"
      },
      {
        "name": "The Fill-versus-Ink Rule",
        "body": "In dark mode, fills read `--color-brand` and text or icons read `--color-primary`, and the two are never swapped. Burgundy text on the night ground fails contrast, and a rose fill reads as candy.",
        "section": "colors"
      },
      {
        "name": "The Gold Is Earned Rule",
        "body": "Gold appears only when the student has earned something: a streak, the daily goal, a badge. A screen with no achievement on it has no gold.",
        "section": "colors"
      },
      {
        "name": "The Counted Numbers Rule",
        "body": "Any number that counts progress (streak, goal, ring percentage, note counts) is set in tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The One Hand Rule",
        "body": "Patrick Hand is reserved for note headings and note callout titles. UI chrome, cards and buttons are always Inter.",
        "section": "typography"
      },
      {
        "name": "The Flat-At-Rest Rule",
        "body": "A surface earns a shadow only by being hovered, floating (modal, popover) or being the selected segment. At rest, a hairline border does the separating.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** fill with `--color-brand` and colour text and icons with `--color-primary`. Never cross them in dark mode.",
      "**Do** keep one filled primary action per screen. On Home it is the Continue card.",
      "**Do** reserve gold for streaks, goals and achievements, and green for done.",
      "**Do** define every new colour in both `[data-theme=\"dark\"]` and `[data-theme=\"light\"]`, and read it through a token.",
      "**Do** set counted numbers in tabular numerals.",
      "**Do** keep interactive targets at 44px or taller and keep the 3px focus ring visible.",
      "**Do** separate surfaces with hairline borders and tonal steps; lift only on hover.",
      "**Do** use lucide line icons at 18–20px.",
      "**Do** gate every entrance animation behind `prefers-reduced-motion`."
    ],
    "donts": [
      "**Don't** return to the retired navy dashboard look: glowing icon tiles, floating emoji, gradient-filled cards and buttons.",
      "**Don't** use burgundy text on the dark ground, or rose as a fill.",
      "**Don't** use gold as a general highlight or for decoration.",
      "**Don't** set UI chrome, cards or buttons in Patrick Hand.",
      "**Don't** hard-code light-only tints such as `#fff7ed` or `#fee2e2`; they glare on the night ground.",
      "**Don't** give resting cards anything heavier than the rest shadow."
    ]
  }
}